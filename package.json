{
  "name": "arthaton-nse-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "NSE Copilot — calibrated, abstaining decision support for Indian equities. Arthaton 2026 submission.",
  "engines": {
    "node": ">=22.9"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "cache:clear": "tsx --env-file-if-exists=.env.local scripts/cache-clear.ts",
    "test:e2e": "playwright test",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "preflight": "tsx --env-file-if-exists=.env.local scripts/preflight.ts",
    "demo": "tsx --env-file-if-exists=.env.local scripts/demo.ts",
    "demo-check": "npm run preflight && npm run eval && npm run test:e2e",
    "verify": "npm run lint && npm run typecheck && npm test",
    "ml:serve": "python -m uvicorn copilot.api:app --app-dir ml/src --host 127.0.0.1 --port 8000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@auth/drizzle-adapter": "1.11.3",
    "@dagrejs/dagre": "3.1.3",
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-pgvector": "0.0.16",
    "@neondatabase/serverless": "1.1.0",
    "@splinetool/react-spline": "4.2.0",
    "@splinetool/runtime": "1.12.98",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "lucide-react": "1.31.0",
    "motion": "13.1.0",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "thinking-orbs": "0.3.1",
    "tw-animate-css": "1.4.0",
    "unpdf": "1.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@next/env": "16.3.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "shadcn": "4.18.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  }
}
